# ========================================================
# SERVER & SECURITY
# ========================================================
# PORT is injected by cPanel/Passenger in production. Use 4000 for local development.
PORT=4000
API_SECRET=changeme
ECOMMERCE_WEBHOOK_KEYS_JSON={"replace-with-key-id":"replace-with-secret"}
ECOMMERCE_API_URL=https://your-ecommerce-domain.example
ECOMMERCE_AGENT_CODE=openclaw
ECOMMERCE_AGENT_TOKEN=

# ========================================================
# DAN_AI INTEGRATION
# ========================================================
# [LOCAL / DOCKER]
DAN_AI_API_URL=http://dan-ai-app:3000
# DAN_AI_API_URL=http://127.0.0.1:3000

# [PRODUCTION]
# DAN_AI_API_URL=https://your-dan-ai-domain.example

DAN_AI_API_SECRET=your_dan_ai_api_secret
DAN_AI_API_TIMEOUT_MS=5000
CEO_DISCORD_USER_IDS=
CEO_DASHBOARD_ACTOR_IDS=ceo-dashboard

# ========================================================
# MODEL ASSIGNMENTS
# ========================================================
DAN_RND_MODEL=gemini:models/gemini-2.5-flash
DAN_RND_FALLBACK_MODEL=claude:claude-sonnet-4-6
DAN_LOGISTICS_MODEL=gemini:models/gemini-2.5-flash
DAN_LOGISTICS_FALLBACK_MODEL=claude:claude-sonnet-4-6
DAN_CFO_MODEL=gemini:models/gemini-2.5-flash
DAN_CFO_FALLBACK_MODEL=claude:claude-sonnet-4-6
DAN_OPS_MODEL=gemini:models/gemini-2.5-flash
DAN_OPS_FALLBACK_MODEL=claude:claude-sonnet-4-6
DAN_CSKH_MODEL=gemini:models/gemini-2.5-flash
DAN_CSKH_FALLBACK_MODEL=claude:claude-sonnet-4-6

DAILY_REPORT_ENABLED=false
DAILY_REPORT_TIMEZONE=Asia/Ho_Chi_Minh
DAILY_REPORT_TIME=18:00
DAILY_REPORT_AGENT_TIMEOUT_MS=5000
ORCHESTRATOR_PRODUCTION_ENABLED=false
INTELLIGENCE_LATENCY_WARNING_MS=30000
INTELLIGENCE_TOKEN_WARNING=10000
INTELLIGENCE_COST_WARNING_USD=1
CEO_DAILY_BRIEF_ENABLED=false
CEO_DAILY_BRIEF_TIMEZONE=Asia/Ho_Chi_Minh
CEO_DAILY_BRIEF_TIME=18:05
CEO_DAILY_BRIEF_SECTION_TIMEOUT_MS=5000
GOOGLE_CX=
GOOGLE_KEY=

# ========================================================
# AI PROVIDERS & API KEYS
# ========================================================
GEMINI_KEY="your_gemini_api_key"
CLAUDE_KEY="your_claude_api_key"
CLAUDE_BASE_URL="https://your-claude-proxy-url.com/"
OPENAI_KEY="your_openai_api_key"

# ========================================================
# ORCHESTRATOR DATABASE (MySQL / MariaDB)
# ========================================================
# [LOCAL / DOCKER]
ORCHESTRATOR_DB_HOST=db
# ORCHESTRATOR_DB_HOST=127.0.0.1
ORCHESTRATOR_DB_PORT=3306
ORCHESTRATOR_DB_NAME=dan_ai
ORCHESTRATOR_DB_USER=dan_ai
ORCHESTRATOR_DB_PASSWORD=dan_ai
ORCHESTRATOR_DB_POOL_MIN=2
ORCHESTRATOR_DB_POOL_MAX=10

# [PRODUCTION - cPanel / VPS]
# ORCHESTRATOR_DB_HOST=127.0.0.1
# ORCHESTRATOR_DB_PORT=3306
# ORCHESTRATOR_DB_NAME=hpdev_openclaw
# ORCHESTRATOR_DB_USER=hpdev_ai
# ORCHESTRATOR_DB_PASSWORD=your_production_password
