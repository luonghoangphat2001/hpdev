# ========================================================
# SERVER & APP
# ========================================================
PORT=3000
NODE_ENV=production
APP_VERSION=2.1.0
TRUST_PROXY=true

# ========================================================
# CORS DOMAINS
# ========================================================
CORS_ORIGIN=https://ai.hpdev.name.vn,https://openclaw.hpdev.name.vn,https://api.hpdev.name.vn,http://localhost:5173,http://localhost:5174,http://localhost:3000

# ========================================================
# DATABASE (MySQL - Unified Database dan_ai)
# ========================================================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=dan_ai_user
DB_PASSWORD=your_secure_password
DB_NAME=dan_ai

# ========================================================
# AI PROVIDER API KEYS & BASE URLS
# ========================================================
GEMINI_KEY=your_gemini_api_key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com
GEMINI_MODEL=gemini-2.5-flash

ANTHROPIC_KEY=your_claude_api_key
CLAUDE_KEY=your_claude_api_key
CLAUDE_BASE_URL=https://api.anthropic.com
CLAUDE_API_BASE_URL=https://api.anthropic.com
CLAUDE_MODEL=claude-sonnet-4-6

OPENAI_KEY=your_openai_api_key
OPENAI_BASE_URL=https://api.openai.com/v1
CHATGPT_MODEL=gpt-4o

CLOUDFLARE_API_TOKEN=your_cloudflare_api_token
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id
CLOUDFLARE_BASE_URL=https://api.cloudflare.com/client/v4/accounts/your_cloudflare_account_id
CLOUDFLARE_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

NVIDIA_API_KEY=your_nvidia_api_key
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=meta/llama-3.1-8b-instruct

DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat

KIMI_API_KEY=your_kimi_api_key
KIMI_BASE_URL=https://api.moonshot.cn/v1
KIMI_MODEL=moonshot-v1-8k

VLLM_API_KEY=your_vllm_api_key
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

OLLAMA_API_KEY=ollama
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=llama3.1

# ========================================================
# EXTERNAL APIS & INTEGRATIONS
# ========================================================
DISCORD_API_BASE_URL=https://discord.com/api/v10
DICTIONARY_API_URL=https://api.dictionaryapi.dev/api/v2/entries/en
DUCKDUCKGO_SEARCH_API_URL=https://api.duckduckgo.com

# ========================================================
# BOTS (DISCORD & TELEGRAM)
# ========================================================
DISCORD_TOKEN=your_discord_bot_token
DISCORD_CLIENT_ID=your_discord_client_id
TELEGRAM_TOKEN=your_telegram_bot_token

# ========================================================
# OPENCLAW INTEGRATION
# ========================================================
OPENCLAW_API_URL=http://127.0.0.1:4000
OPENCLAW_API_SECRET=your_openclaw_shared_secret
OPENCLAW_TIMEOUT_MS=30000
SESSION_SECRET=your_session_jwt_secret_key_32_chars_min
